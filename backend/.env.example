# Zona waktu pencatatan absen & jam masuk kerja (lewat jam ini = terlambat)
TZ=Asia/Jakarta
WORK_START_TIME=09:00
# Batas akhir absen harian: lewat jam ini check-in & check-out ditolak
CHECK_OUT_MAX_TIME=22:00
# Hari kerja mingguan (1 = Senin ... 7 = Minggu). Hari libur nasional/perusahaan diatur HRD di menu Hari Libur.
WORK_DAYS=1,2,3,4,5
# Sumber libur nasional & cuti bersama, disinkronkan saat start dan tiap 24 jam. Kosongkan untuk menonaktifkan.
# Default: API Tanggal Merah (https://github.com/upsetdev/tanggalmerah), diambil per tahun lewat /years dan /holidays?year=.
# Bisa juga URL file .json: format Tanggal Merah ({ holidays: [...] }) atau APIHariLibur ({ "YYYY-MM-DD": { "summary": "..." } }).
HOLIDAY_SYNC_URL=https://tanggalmerah.upset.dev/api

# Database MySQL lokal
DB_HOST=localhost
DB_PORT=3306
DB_USER=dexa
DB_PASSWORD=dexa
DB_NAME=dexa_wfh

# JWT
# Generate: openssl rand -base64 48
JWT_SECRET=ganti-dengan-secret-yang-panjang
JWT_EXPIRES_IN=8h

# Redis: penghitung login gagal (gateway) & status/kunci sinkron hari libur (attendance-service).
# Bila Redis mati, login tetap jalan tanpa pembatasan dan peringatan muncul di log.
REDIS_URL=redis://127.0.0.1:6379

# Batas login gagal: per email LOGIN_MAX_ATTEMPTS kali, per IP 4x lipatnya, dalam LOGIN_LOCK_MINUTES menit
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Port API Gateway (HTTP) & microservices (TCP)
GATEWAY_PORT=3000
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001
EMPLOYEE_SERVICE_HOST=127.0.0.1
EMPLOYEE_SERVICE_PORT=4002
ATTENDANCE_SERVICE_HOST=127.0.0.1
ATTENDANCE_SERVICE_PORT=4003
LEAVE_SERVICE_HOST=127.0.0.1
LEAVE_SERVICE_PORT=4004

# Upload foto (disimpan di disk lokal backend)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
CORS_ORIGIN=http://localhost:5173
